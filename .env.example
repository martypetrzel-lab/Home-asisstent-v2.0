# Serverové hodnoty: zkopírujte do .env.local, skutečná hesla necommitujte.
ESP32_API_URL=http://homeassistant-esp32.local/api
# Shodný s HOME_API_TOKEN, alespoň 32 náhodných znaků.
ESP32_API_TOKEN=
# Heslo pro tablet, alespoň 16 znaků.
DASHBOARD_PASSWORD=
# Samostatné náhodné tajemství alespoň 32 znaků.
SESSION_SECRET=
# Za HTTPS proxy přesný původ, například https://panel.home.arpa
DASHBOARD_ORIGIN=
# Pro místní přihlášenou bránu ponechte prázdné.
NEXT_PUBLIC_ESP32_API_URL=

# Railway: cloud. Pro původní LAN bránu: local.
ESP32_TRANSPORT=cloud
# Shodné s HOME_CLOUD_TOKEN ve firmwaru (alespoň 32 znaků).
DEVICE_TOKEN=
DEVICE_ID=homeassistant-esp32
# Na Railway připojte volume /data a nastavte CLOUD_DATA_DIR=/data.
# Lokálně lze ponechat prázdné, použije se ignorovaná .data/.
CLOUD_DATA_DIR=
RAILPACK_NODE_VERSION=24
